# ============================================================
#  Grupo Anuna — configuración para Hostinger (Apache/LiteSpeed)
# ============================================================
Options -Indexes
DirectoryIndex index.html index.php

# Forzar HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Rutas de Angular: si no existe el archivo o carpeta, servir index.html
# (las páginas prerenderizadas, como /cloud, ya tienen su propio index.html)
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Caché larga para los archivos con hash del build; corta para el HTML
<IfModule mod_headers.c>
  # JS y CSS del build llevan un hash en el nombre: se pueden cachear un año
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imágenes sin hash (fotos del equipo, capturas): una semana, para que los cambios se vean
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
